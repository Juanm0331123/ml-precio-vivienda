<mxfile host="app.diagrams.net"><diagram id="pipeline" name="Pipeline T11"><mxGraphModel dx="1920" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="Pipeline experimental de regresión: predicción del precio de vivienda (Windsor, 1987)" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#0F2A47;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1840" height="50" as="geometry"/></mxCell><mxCell id="subtitulo" value="T11 · 3 preprocesamientos × 6 modelos = 18 pipelines · todo lo ajustable se ajusta solo con el pliegue de entrenamiento" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontColor=#5A6B7E;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1840" height="36" as="geometry"/></mxCell><mxCell id="datos" value="&lt;b style=&quot;font-size:24px;color:#0F2A47&quot;&gt;DATASET ORIGINAL&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;Housing.csv&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;545 filas × 13 columnas&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;precio + 12 atributos&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;Windsor (Canadá), 1987&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;vía Kaggle · T05&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F0FB;strokeColor=#2B6CC4;strokeWidth=2;verticalAlign=middle;align=center;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="330" height="220" as="geometry"/></mxCell><mxCell id="calidad" value="&lt;b style=&quot;font-size:19px;color:#0F2A47&quot;&gt;CALIDAD Y PREPARACIÓN · T06&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;0 faltantes (completitud 100 %)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;binarias → 0/1&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;furnishingstatus codificada&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;sin escalado ni transformaciones&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;(esas se ajustan en el pipeline)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF1F6;strokeColor=#5A6B7E;strokeWidth=2;verticalAlign=middle;align=center;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="420" y="110" width="340" height="220" as="geometry"/></mxCell><mxCell id="particion" value="&lt;b style=&quot;font-size:24px;color:#0F2A47&quot;&gt;PARTICIÓN 80/20&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;estratificada por quintiles&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;de precio · semilla 5007&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF1F6;strokeColor=#5A6B7E;strokeWidth=2;verticalAlign=middle;align=center;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="810" y="150" width="290" height="140" as="geometry"/></mxCell><mxCell id="test" value="&lt;b style=&quot;font-size:20px;color:#B5532F&quot;&gt;TEST SELLADO · 109 filas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;NO SE UTILIZA en validación,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;ajuste ni selección&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FBE9E4;strokeColor=#B5532F;strokeWidth=2;dashed=1;verticalAlign=middle;align=center;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="1160" y="110" width="330" height="120" as="geometry"/></mxCell><mxCell id="train" value="&lt;b style=&quot;font-size:20px;color:#0F2A47&quot;&gt;ENTRENAMIENTO · 436 filas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;único dato que usa el modelado&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=